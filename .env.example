# Settings the Task API reads from the environment. Compose and Kubernetes set
# them for you; this file is only for running the app by hand, for example with
#   node --env-file=.env src/server.js     or     docker run --env-file .env ...
# Copy to .env (never commit .env). Leave DB_HOST unset to use the in-memory store.
PORT=3000
# APP_VERSION=1.1.0
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=tasks
# DB_NAME=tasks
# DB_PASSWORD_FILE=./secrets/db_password.txt
# DB_PASSWORD=change-me     # only if you cannot use DB_PASSWORD_FILE
